# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/english_draft
# Override if port 5432 is already in use on your machine (e.g. POSTGRES_PORT=5433)
POSTGRES_PORT=5432

# ─── MinIO ──────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=english-draft

# ─── Gemini API (Key Pool) ──────────────────────────────────────────────────
# Comma-separated list of API keys. Requests rotate round-robin; on 429 the
# next key is tried. When all keys for a model are exhausted, the system
# cascades to a lighter model before reporting an error.
GEMINI_API_KEYS=your-key-1,your-key-2

# ─── Better Auth ────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
